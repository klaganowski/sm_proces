    <bpmn:textAnnotation id="TextAnnotation_0ponnit">
      <bpmn:text>zaznaczyc rekomendacje/zachecenia</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_17oges5">
      <bpmn:text>Nowe statusy w Kampaniio:
- Do potwierdzenia (entry point)
- Potwierdzone przez Twórcę
- Zrzucone</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_15w0pup">
      <bpmn:text>ewentualny proces negocjacji</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0p034oe">
      <bpmn:text>ewentualny proces negocjacji</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0gkftq5">
      <bpmn:text>+ weryfikacja umowy</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02aqr9h">
      <bpmn:text>jest w tym deadline</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_17xt20t">
      <bpmn:text>wraz z kompletem informacji/uwag</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0frzxcr">
      <bpmn:text>wraz z kompletem informacji/uwag</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0x2g92j">
      <bpmn:text>konkretna pelna informacja w przypadku braku</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1gmrut3">
      <bpmn:text>potwierdza brak zastrzezen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_00fzwxj">
      <bpmn:text>z uwzglednieniem terminu</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_030wpc8">
      <bpmn:text>definicja dobrze opublikowanego</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1twv2n3">
      <bpmn:text>definicja dobrze opublikowanego</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1951h9y">
      <bpmn:text>standard zbierania statystyk</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1njn797">
      <bpmn:text>sensowne update przy ofercie</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1mvt7py">
      <bpmn:text>poprawnie opublikowany:
- czy w dobrym momencie
- tytul
- opis
- przypiety komentarz
- czy link dziala i sie zgadza</bpmn:text>
    </bpmn:textAnnotation>
